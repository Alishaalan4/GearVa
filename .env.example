NODE_ENV=development

# Database (three roles, see docs/database.md section 6)
DATABASE_URL=postgresql://gearva_app:gearva_app@localhost:5432/gearva
MIGRATION_DATABASE_URL=postgresql://gearva_migrator:gearva_migrator@localhost:5432/gearva
PLATFORM_DATABASE_URL=postgresql://gearva_platform:gearva_platform@localhost:5432/gearva

REDIS_URL=redis://localhost:6379

# Auth
# At least 32 characters in production.
JWT_ACCESS_SECRET=change-me
APP_URL_GARAGE=http://localhost:3000
APP_URL_ADMIN=http://localhost:3001
API_URL=http://localhost:4000
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Seed (npm run db:seed): the first SUPER_ADMIN. Password: at least 12 characters.
SEED_ADMIN_EMAIL=admin@gearva.online
SEED_ADMIN_PASSWORD=
# Development only: a demo garage whose owner can sign in to garage-web at once.
# Leave empty to skip. Password: at least 10 characters.
SEED_DEMO_OWNER_EMAIL=owner@demo.gearva.local
SEED_DEMO_OWNER_PASSWORD=

# Email (adapter: console | resend | ses)
EMAIL_ADAPTER=console
EMAIL_FROM="Gearva <no-reply@gearva.online>"
RESEND_API_KEY=

# Files (adapter: local | s3)
FILES_ADAPTER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Later
WHATSAPP_ADAPTER=disabled
