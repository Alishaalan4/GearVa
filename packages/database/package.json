{
  "name": "@gearva/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset",
    "studio": "prisma studio",
    "seed": "npm run build && prisma db seed",
    "rls:sql": "tsc -p tsconfig.build.json && node dist/scripts/print-rls-sql.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@gearva/config": "*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prisma": "~7.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
