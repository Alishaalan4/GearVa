// Source of truth for this schema: docs/database.md.
// RLS policies, grants and partial indexes live as raw SQL in the migrations (section 10).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (database.md section 5)
// ---------------------------------------------------------------------------

enum GarageStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum StaffRole {
  OWNER
  MANAGER
  MECHANIC
  RECEPTIONIST
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum SubjectType {
  STAFF
  ADMIN
  OWNER
}

enum ActorType {
  STAFF
  ADMIN
  OWNER
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
  WHATSAPP
}

enum NotificationType {
  SERVICE_REMINDER
  MONTHLY_REMINDER
  INVOICE
  OFFER
  INVITE
  CAR_READY
  WARRANTY_END
  PAYMENT_REMINDER
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum DistanceUnit {
  KM
  MI
}

enum VisitStatus {
  IN_PROGRESS
  WAITING_FOR_PARTS
  DONE
}

enum ReminderKind {
  SERVICE_DUE
  WARRANTY_END
  RECOMMENDED_NEXT
}

enum ReminderStatus {
  ACTIVE
  SENT
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  WHISH
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum InvoiceEditWindow {
  SAME_DAY
}

enum FileKind {
  LOGO
  SERVICE_PHOTO
  INVOICE_PDF
  OFFER_IMAGE
}

enum OfferTarget {
  ALL
  OVERDUE
  INACTIVE_6M
}

enum SuggestionField {
  OIL_BRAND
  OIL_GRADE
  FILTER_BRAND
  BATTERY_BRAND
  TIRE_BRAND
  BRAKE_PAD_BRAND
  SERVICE_NAME
  VEHICLE_MAKE
  VEHICLE_MODEL
}

// ---------------------------------------------------------------------------
// Platform tables (section 4.1, no garage_id, no RLS)
// ---------------------------------------------------------------------------

model AdminUser {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  role              AdminRole
  totpSecretEnc     String?   @map("totp_secret_enc")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  recoveryCodesHash String[]  @default([]) @map("recovery_codes_hash")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdGarages Garage[]

  @@map("admin_users")
}

model Session {
  id               String      @id @default(uuid(7)) @db.Uuid
  subjectType      SubjectType @map("subject_type")
  // id in users / admin_users / owners, so no foreign key
  subjectId        String      @map("subject_id") @db.Uuid
  refreshTokenHash String      @unique @map("refresh_token_hash")
  userAgent        String?     @map("user_agent")
  ip               String?
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@map("sessions")
}

// Global car-owner account, one per phone (section 4.1). Not a tenant table, but garage
// code may read only the owners linked to its own customers (owners_linked_read policy),
// and creates or finds one only through find_or_create_owner() (section 6.6).
model Owner {
  id          String    @id @default(uuid(7)) @db.Uuid
  // E.164, the login identity (Phase 6)
  phone       String    @unique
  // the name given by the first garage that added them
  name        String
  email       String?
  locale      String
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  garageCustomers GarageCustomer[]
  vehicles        Vehicle[]
  visits          Visit[]
  serviceRecords  ServiceRecord[]
  reminders       Reminder[]
  notifications   Notification[]
  invoices        Invoice[]

  @@map("owners")
}

// ---------------------------------------------------------------------------
// Tenant root and settings (section 4.2)
// ---------------------------------------------------------------------------

model Garage {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  email            String
  phone            String
  locationText     String       @map("location_text")
  timezone         String       @default("Asia/Beirut")
  defaultLocale    String       @map("default_locale")
  status           GarageStatus
  isPaid           Boolean      @default(false) @map("is_paid")
  trialEndsAt      DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  expiresAt        DateTime?    @map("expires_at") @db.Timestamptz(3)
  suspendedAt      DateTime?    @map("suspended_at") @db.Timestamptz(3)
  suspendedReason  String?      @map("suspended_reason")
  createdByAdminId String       @map("created_by_admin_id") @db.Uuid
  lastLoginAt      DateTime?    @map("last_login_at") @db.Timestamptz(3)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdByAdmin  AdminUser        @relation(fields: [createdByAdminId], references: [id])
  settings        GarageSettings?
  branches        Branch[]
  users           User[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  customers       GarageCustomer[]
  vehicles        Vehicle[]
  serviceTypes    ServiceType[]
  suggestions     Suggestion[]
  visits          Visit[]
  serviceRecords  ServiceRecord[]
  reminders       Reminder[]
  files           File[]
  offers          Offer[]
  invoiceCounters InvoiceCounter[]
  invoices        Invoice[]
  invoiceItems    InvoiceItem[]
  payments        Payment[]

  @@index([status, expiresAt])
  @@map("garages")
}

model GarageSettings {
  garageId               String            @id @map("garage_id") @db.Uuid
  logoFileId             String?           @map("logo_file_id") @db.Uuid
  brandColor             String            @default("#111827") @map("brand_color")
  invoiceNumberFormat    String            @default("{BRANCH}-{YYYY}-{SEQ:4}") @map("invoice_number_format")
  termsText              String?           @map("terms_text")
  autoSendInvoice        Boolean           @default(false) @map("auto_send_invoice")
  showLbp                Boolean           @default(false) @map("show_lbp")
  // display-only rate: LBP per 1 USD
  lbpRate                Int?              @map("lbp_rate")
  vatEnabled             Boolean           @default(false) @map("vat_enabled")
  vatRatePercent         Decimal?          @map("vat_rate_percent") @db.Decimal(5, 2)
  vatNumber              String?           @map("vat_number")
  paymentReminderDays    Int?              @map("payment_reminder_days")
  reminderLeadKm         Int               @default(500) @map("reminder_lead_km")
  reminderLeadDays       Int               @default(7) @map("reminder_lead_days")
  defaultDailyKm         Int?              @map("default_daily_km")
  invoiceEditWindow      InvoiceEditWindow @default(SAME_DAY) @map("invoice_edit_window")
  // flow.md 9.2: off by default (decision 2026-11-05)
  monthlyReminderEnabled Boolean           @default(false) @map("monthly_reminder_enabled")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage Garage @relation(fields: [garageId], references: [id])
  logo   File?  @relation("GarageLogo", fields: [garageId, logoFileId], references: [garageId, id], onDelete: Restrict)

  @@map("garage_settings")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  garageId  String   @map("garage_id") @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage          Garage           @relation(fields: [garageId], references: [id])
  users           User[]
  visits          Visit[]
  serviceRecords  ServiceRecord[]
  invoiceCounters InvoiceCounter[]
  invoices        Invoice[]

  @@unique([garageId, code])
  // Target of the garage-scoped foreign keys (section 6.6): a row can only point to a
  // branch of its own garage.
  @@unique([garageId, id])
  @@map("branches")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  garageId        String    @map("garage_id") @db.Uuid
  // null = access to all branches (owner/manager)
  branchId        String?   @map("branch_id") @db.Uuid
  // globally unique login identity, stored lowercase
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String
  role            StaffRole
  locale          String
  isActive        Boolean   @default(true) @map("is_active")
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage            Garage          @relation(fields: [garageId], references: [id])
  branch            Branch?         @relation(fields: [branchId], references: [id])
  notifications     Notification[]
  visits            Visit[]
  serviceRecords    ServiceRecord[]
  filesCreated      File[]
  offersCreated     Offer[]
  invoicesCreated   Invoice[]       @relation("InvoiceCreatedBy")
  invoicesEdited    Invoice[]       @relation("InvoiceLastEditedBy")
  invoicesCancelled Invoice[]       @relation("InvoiceCancelledBy")
  paymentsReceived  Payment[]

  // Target of the garage-scoped foreign keys (section 6.6).
  @@unique([garageId, id])
  @@index([garageId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers and vehicles (section 4.3)
//
// Links between tenant rows use garage-scoped foreign keys: (garage_id, x_id) points to
// (garage_id, id) of the parent, so the database itself refuses a row that points into
// another garage, even if a query forgot its filter (section 6.6).
// ---------------------------------------------------------------------------

model GarageCustomer {
  id              String    @id @default(uuid(7)) @db.Uuid
  garageId        String    @map("garage_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  // the garage's own name for the customer
  name            String
  // private to this garage
  notes           String?
  // the garage's own contact email for reminders (flow.md 9), not the owner's login
  email           String?
  inviteSentAt    DateTime? @map("invite_sent_at") @db.Timestamptz(3)
  remindersOptOut Boolean   @default(false) @map("reminders_opt_out")
  marketingOptOut Boolean   @default(false) @map("marketing_opt_out")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage   Garage    @relation(fields: [garageId], references: [id])
  owner    Owner     @relation(fields: [ownerId], references: [id])
  vehicles Vehicle[]
  visits   Visit[]
  invoices Invoice[]

  @@unique([garageId, ownerId])
  @@unique([garageId, id])
  @@index([garageId, deletedAt])
  @@map("garage_customers")
}

model Vehicle {
  id               String       @id @default(uuid(7)) @db.Uuid
  garageId         String       @map("garage_id") @db.Uuid
  garageCustomerId String       @map("garage_customer_id") @db.Uuid
  // denormalized from the customer, for the owner app (Phase 6)
  ownerId          String       @map("owner_id") @db.Uuid
  // as typed
  plate            String
  // uppercase, no spaces or dashes; unique per garage among cars not deleted (SQL)
  plateNormalized  String       @map("plate_normalized")
  make             String
  model            String
  year             Int?
  distanceUnit     DistanceUnit @default(KM) @map("distance_unit")
  // last recorded odometer, in km
  currentKm        Int          @map("current_km")
  lastOdometerAt   DateTime?    @map("last_odometer_at") @db.Timestamptz(3)
  // recalculated after each visit (flow.md section 5)
  avgDailyKm       Decimal?     @map("avg_daily_km") @db.Decimal(7, 2)
  notes            String?
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage         Garage          @relation(fields: [garageId], references: [id])
  customer       GarageCustomer  @relation(fields: [garageId, garageCustomerId], references: [garageId, id])
  owner          Owner           @relation(fields: [ownerId], references: [id])
  visits         Visit[]
  serviceRecords ServiceRecord[]
  reminders      Reminder[]
  invoices       Invoice[]

  @@unique([garageId, id])
  @@index([garageId, garageCustomerId])
  @@index([ownerId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Services, visits, records, reminders (section 4.4)
// ---------------------------------------------------------------------------

// garageId null = global default (seeded, managed in V2); set = a garage's override.
// Garages read both; they can change only their own rows (section 6.2, special policy).
model ServiceType {
  id                    String   @id @default(uuid(7)) @db.Uuid
  garageId              String?  @map("garage_id") @db.Uuid
  code                  String
  nameAr                String   @map("name_ar")
  nameEn                String   @map("name_en")
  // null = time-based only
  defaultIntervalKm     Int?     @map("default_interval_km")
  defaultIntervalMi     Int?     @map("default_interval_mi")
  defaultIntervalMonths Int?     @map("default_interval_months")
  // which Zod schema validates ServiceRecord.details
  detailKey             String?  @map("detail_key")
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage         Garage?         @relation(fields: [garageId], references: [id], onDelete: Restrict)
  serviceRecords ServiceRecord[]
  reminders      Reminder[]

  // Unique code per garage, and among global rows: two partial unique indexes (SQL).
  @@map("service_types")
}

// Per-garage autocomplete (flow.md 4.3). Never shared between garages.
model Suggestion {
  id              String          @id @default(uuid(7)) @db.Uuid
  garageId        String          @map("garage_id") @db.Uuid
  field           SuggestionField
  // display value as first typed ("Castrol")
  value           String
  // lowercase, trimmed, collapsed spaces; prefix search index in SQL
  valueNormalized String          @map("value_normalized")
  useCount        Int             @default(1) @map("use_count")
  lastUsedAt      DateTime        @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage Garage @relation(fields: [garageId], references: [id])

  @@unique([garageId, field, valueNormalized])
  @@map("suggestions")
}

model Visit {
  id               String      @id @default(uuid(7)) @db.Uuid
  garageId         String      @map("garage_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  vehicleId        String      @map("vehicle_id") @db.Uuid
  garageCustomerId String      @map("garage_customer_id") @db.Uuid
  // denormalized, for the owner app (Phase 6)
  ownerId          String      @map("owner_id") @db.Uuid
  // the signed-in user who opened it
  mechanicId       String      @map("mechanic_id") @db.Uuid
  status           VisitStatus @default(IN_PROGRESS)
  odometerKm       Int         @map("odometer_km")
  openedAt         DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  // set by "Finish visit" (from Phase 3 it also creates the invoice)
  finishedAt       DateTime?   @map("finished_at") @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage   Garage          @relation(fields: [garageId], references: [id])
  branch   Branch          @relation(fields: [garageId, branchId], references: [garageId, id])
  vehicle  Vehicle         @relation(fields: [garageId, vehicleId], references: [garageId, id])
  customer GarageCustomer  @relation(fields: [garageId, garageCustomerId], references: [garageId, id])
  owner    Owner           @relation(fields: [ownerId], references: [id])
  mechanic User            @relation(fields: [garageId, mechanicId], references: [garageId, id])
  records  ServiceRecord[]
  invoices Invoice[]

  @@unique([garageId, id])
  @@index([garageId, branchId, openedAt(sort: Desc)])
  @@index([vehicleId, openedAt(sort: Desc)])
  @@map("visits")
}

// Never deleted (section 1): no DELETE grant for the runtime roles.
model ServiceRecord {
  id                     String    @id @default(uuid(7)) @db.Uuid
  garageId               String    @map("garage_id") @db.Uuid
  branchId               String    @map("branch_id") @db.Uuid
  visitId                String    @map("visit_id") @db.Uuid
  vehicleId              String    @map("vehicle_id") @db.Uuid
  // denormalized, for the owner app (Phase 6)
  ownerId                String    @map("owner_id") @db.Uuid
  serviceTypeId          String    @map("service_type_id") @db.Uuid
  // used when the type is OTHER
  customName             String?   @map("custom_name")
  performedAt            DateTime  @map("performed_at") @db.Timestamptz(3)
  // km at service time
  odometerKm             Int       @map("odometer_km")
  quantity               Decimal   @default(1) @db.Decimal(8, 2)
  unitPriceCents         Int       @map("unit_price_cents")
  // quantity x unit price, rounded to whole cents
  totalCents             Int       @map("total_cents")
  laborCents             Int?      @map("labor_cents")
  partsCents             Int?      @map("parts_cents")
  mechanicId             String    @map("mechanic_id") @db.Uuid
  notes                  String?
  // service-specific fields, validated by the schema named in service_types.detailKey
  details                Json      @default("{}")
  warrantyUntil          DateTime? @map("warranty_until") @db.Date
  recommendedNote        String?   @map("recommended_note")
  recommendedAfterMonths Int?      @map("recommended_after_months")
  // computed on save (flow.md section 6)
  nextDueKm              Int?      @map("next_due_km")
  nextDueDate            DateTime? @map("next_due_date") @db.Date
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage       Garage        @relation(fields: [garageId], references: [id])
  branch       Branch        @relation(fields: [garageId, branchId], references: [garageId, id])
  visit        Visit         @relation(fields: [garageId, visitId], references: [garageId, id])
  vehicle      Vehicle       @relation(fields: [garageId, vehicleId], references: [garageId, id])
  owner        Owner         @relation(fields: [ownerId], references: [id])
  serviceType  ServiceType   @relation(fields: [serviceTypeId], references: [id])
  mechanic     User          @relation(fields: [garageId, mechanicId], references: [garageId, id])
  reminders    Reminder[]
  invoiceItems InvoiceItem[]
  files        File[]

  @@unique([garageId, id])
  @@index([vehicleId, serviceTypeId, performedAt(sort: Desc)])
  @@index([garageId, performedAt(sort: Desc)])
  @@index([visitId])
  @@map("service_records")
}

model Reminder {
  id             String         @id @default(uuid(7)) @db.Uuid
  garageId       String         @map("garage_id") @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  ownerId        String         @map("owner_id") @db.Uuid
  serviceTypeId  String?        @map("service_type_id") @db.Uuid
  // the record that created it
  sourceRecordId String         @map("source_record_id") @db.Uuid
  kind           ReminderKind
  // in km
  nextDueKm      Int?           @map("next_due_km")
  // time fallback
  nextDueDate    DateTime?      @map("next_due_date") @db.Date
  status         ReminderStatus @default(ACTIVE)
  notifyCount    Int            @default(0) @map("notify_count")
  lastNotifiedAt DateTime?      @map("last_notified_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage       Garage        @relation(fields: [garageId], references: [id])
  vehicle      Vehicle       @relation(fields: [garageId, vehicleId], references: [garageId, id])
  owner        Owner         @relation(fields: [ownerId], references: [id])
  serviceType  ServiceType?  @relation(fields: [serviceTypeId], references: [id])
  sourceRecord ServiceRecord @relation(fields: [garageId, sourceRecordId], references: [garageId, id])

  @@index([garageId, status, nextDueDate])
  @@index([vehicleId, serviceTypeId, status])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// Invoices and payments (section 4.5), offers and files (section 4.6)
// ---------------------------------------------------------------------------

model File {
  id              String   @id @default(uuid(7)) @db.Uuid
  garageId        String   @map("garage_id") @db.Uuid
  kind            FileKind
  storageKey      String   @map("storage_key")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  serviceRecordId String?  @map("service_record_id") @db.Uuid
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  garage        Garage           @relation(fields: [garageId], references: [id])
  serviceRecord ServiceRecord?   @relation(fields: [garageId, serviceRecordId], references: [garageId, id], onDelete: Restrict)
  createdBy     User             @relation(fields: [garageId, createdById], references: [garageId, id])
  logoOf        GarageSettings[] @relation("GarageLogo")
  offers        Offer[]
  invoices      Invoice[]

  @@unique([garageId, id])
  @@map("files")
}

// Rows are switched off with isActive, never deleted.
model Offer {
  id            String       @id @default(uuid(7)) @db.Uuid
  garageId      String       @map("garage_id") @db.Uuid
  title         String
  body          String
  imageFileId   String?      @map("image_file_id") @db.Uuid
  discountType  DiscountType @map("discount_type")
  // cents or percent
  discountValue Int          @map("discount_value")
  startsAt      DateTime     @map("starts_at") @db.Timestamptz(3)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(3)
  target        OfferTarget
  isActive      Boolean      @default(true) @map("is_active")
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage    Garage    @relation(fields: [garageId], references: [id])
  image     File?     @relation(fields: [garageId, imageFileId], references: [garageId, id], onDelete: Restrict)
  createdBy User      @relation(fields: [garageId, createdById], references: [garageId, id])
  invoices  Invoice[]

  @@unique([garageId, id])
  @@map("offers")
}

// Gap-free numbering (flow.md 7.1): the row lock serializes concurrent invoices.
model InvoiceCounter {
  branchId   String @map("branch_id") @db.Uuid
  year       Int
  garageId   String @map("garage_id") @db.Uuid
  lastNumber Int    @map("last_number")

  garage Garage @relation(fields: [garageId], references: [id])
  branch Branch @relation(fields: [garageId, branchId], references: [garageId, id])

  @@id([branchId, year])
  @@map("invoice_counters")
}

// Never deleted: a mistake is cancelled with a reason (flow.md 7.5). The partial unique
// index "one active invoice per visit" is in the migration; Prisma cannot express it.
model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  garageId          String        @map("garage_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  visitId           String        @map("visit_id") @db.Uuid
  garageCustomerId  String        @map("garage_customer_id") @db.Uuid
  // denormalized, for the owner app (Phase 6)
  ownerId           String        @map("owner_id") @db.Uuid
  vehicleId         String        @map("vehicle_id") @db.Uuid
  number            String
  seq               Int
  year              Int
  status            InvoiceStatus @default(UNPAID)
  issuedAt          DateTime      @map("issued_at") @db.Timestamptz(3)
  locale            String
  subtotalCents     Int           @map("subtotal_cents")
  discountType      DiscountType? @map("discount_type")
  // cents or percent
  discountValue     Int?          @map("discount_value")
  discountCents     Int           @default(0) @map("discount_cents")
  // the rate at issue time: an edit must not pick up a later rate
  vatRatePercent    Decimal?      @map("vat_rate_percent") @db.Decimal(5, 2)
  vatCents          Int           @default(0) @map("vat_cents")
  totalCents        Int           @map("total_cents")
  paidCents         Int           @default(0) @map("paid_cents")
  remainingCents    Int           @map("remaining_cents")
  laborCents        Int?          @map("labor_cents")
  partsCents        Int?          @map("parts_cents")
  offerId           String?       @map("offer_id") @db.Uuid
  // the earliest due of the visit
  nextServiceKm     Int?          @map("next_service_km")
  nextServiceDate   DateTime?     @map("next_service_date") @db.Date
  warrantyText      String?       @map("warranty_text")
  termsSnapshot     String?       @map("terms_snapshot")
  customerSnapshot  Json          @map("customer_snapshot")
  vehicleSnapshot   Json          @map("vehicle_snapshot")
  garageSnapshot    Json          @map("garage_snapshot")
  qrToken           String?       @unique @map("qr_token")
  pdfFileId         String?       @map("pdf_file_id") @db.Uuid
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?       @map("cancel_reason")
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  replacesInvoiceId String?       @map("replaces_invoice_id") @db.Uuid
  createdById       String        @map("created_by_id") @db.Uuid
  lastEditedById    String?       @map("last_edited_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage       Garage         @relation(fields: [garageId], references: [id])
  branch       Branch         @relation(fields: [garageId, branchId], references: [garageId, id])
  visit        Visit          @relation(fields: [garageId, visitId], references: [garageId, id])
  customer     GarageCustomer @relation(fields: [garageId, garageCustomerId], references: [garageId, id])
  owner        Owner          @relation(fields: [ownerId], references: [id])
  vehicle      Vehicle        @relation(fields: [garageId, vehicleId], references: [garageId, id])
  offer        Offer?         @relation(fields: [garageId, offerId], references: [garageId, id], onDelete: Restrict)
  pdfFile      File?          @relation(fields: [garageId, pdfFileId], references: [garageId, id], onDelete: Restrict)
  cancelledBy  User?          @relation("InvoiceCancelledBy", fields: [garageId, cancelledById], references: [garageId, id], onDelete: Restrict)
  createdBy    User           @relation("InvoiceCreatedBy", fields: [garageId, createdById], references: [garageId, id])
  lastEditedBy User?          @relation("InvoiceLastEditedBy", fields: [garageId, lastEditedById], references: [garageId, id], onDelete: Restrict)
  replaces     Invoice?       @relation("InvoiceReplaces", fields: [garageId, replacesInvoiceId], references: [garageId, id], onDelete: Restrict)
  replacedBy   Invoice[]      @relation("InvoiceReplaces")
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([garageId, id])
  @@unique([garageId, number])
  @@unique([branchId, year, seq])
  @@index([garageId, status])
  @@index([garageCustomerId])
  @@index([garageId, issuedAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  garageId        String  @map("garage_id") @db.Uuid
  invoiceId       String  @map("invoice_id") @db.Uuid
  serviceRecordId String? @map("service_record_id") @db.Uuid
  // service name in the invoice language
  description     String
  brand           String?
  grade           String?
  quantity        Decimal @db.Decimal(8, 2)
  unitPriceCents  Int     @map("unit_price_cents")
  totalCents      Int     @map("total_cents")
  position        Int

  garage        Garage         @relation(fields: [garageId], references: [id])
  invoice       Invoice        @relation(fields: [garageId, invoiceId], references: [garageId, id])
  serviceRecord ServiceRecord? @relation(fields: [garageId, serviceRecordId], references: [garageId, id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

// Append-only: the runtime roles have INSERT and SELECT only.
model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  garageId     String        @map("garage_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amountCents  Int           @map("amount_cents")
  method       PaymentMethod
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  receivedById String        @map("received_by_id") @db.Uuid
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  garage     Garage  @relation(fields: [garageId], references: [id])
  invoice    Invoice @relation(fields: [garageId, invoiceId], references: [garageId, id])
  receivedBy User    @relation(fields: [garageId, receivedById], references: [garageId, id])

  @@index([invoiceId])
  @@index([garageId, paidAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notifications and audit (section 4.6)
// ---------------------------------------------------------------------------

model Notification {
  id           String              @id @default(uuid(7)) @db.Uuid
  garageId     String              @map("garage_id") @db.Uuid
  ownerId      String?             @map("owner_id") @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  channel      NotificationChannel
  type         NotificationType
  template     String
  locale       String
  recipient    String?
  payload      Json
  status       NotificationStatus  @default(QUEUED)
  error        String?
  dedupeKey    String              @map("dedupe_key")
  scheduledFor DateTime?           @map("scheduled_for") @db.Timestamptz(3)
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  deliveredAt  DateTime?           @map("delivered_at") @db.Timestamptz(3)
  readAt       DateTime?           @map("read_at") @db.Timestamptz(3)
  refType      String?             @map("ref_type")
  refId        String?             @map("ref_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  garage Garage @relation(fields: [garageId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  owner  Owner? @relation(fields: [ownerId], references: [id])

  @@unique([garageId, dedupeKey])
  @@index([garageId, status, scheduledFor])
  @@index([ownerId, readAt])
  @@map("notifications")
}

// Append-only: no updatedAt, and no UPDATE/DELETE grant for the runtime roles.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  // null only for admin/system actions that touch no garage
  garageId   String?   @map("garage_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // RESTRICT, not SET NULL: audit rows are never rewritten.
  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Restrict)

  @@index([garageId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
